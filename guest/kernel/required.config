# Options the board cannot boot without, one per line. The kernel workflow fails if the final
# configuration does not have every one of them set to "y". Lines for one architecture only are
# prefixed with it.
CONFIG_VIRTIO_MMIO
CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES
CONFIG_VIRTIO_BLK
CONFIG_VIRTIO_NET
CONFIG_VIRTIO_CONSOLE
CONFIG_VIRTIO_INPUT
CONFIG_DRM_VIRTIO_GPU
CONFIG_SND_VIRTIO
CONFIG_DMABUF_HEAPS_SYSTEM
CONFIG_ZRAM
CONFIG_VIRT_WIFI
CONFIG_EROFS_FS
CONFIG_F2FS_FS
CONFIG_SERIAL_8250
CONFIG_SERIAL_8250_CONSOLE
CONFIG_BOOT_CONFIG
CONFIG_BLK_DEV_INITRD
arm64 CONFIG_SERIAL_OF_PLATFORM
arm64 CONFIG_RTC_DRV_PL031
arm64 CONFIG_ARM_GIC_V3
x86_64 CONFIG_X86_MPPARSE
x86_64 CONFIG_X86_X2APIC
x86_64 CONFIG_KVM_GUEST
x86_64 CONFIG_HYPERV
x86_64 CONFIG_RTC_DRV_CMOS
