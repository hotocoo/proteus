+/* Takes ownership of the ralloc'd MSL text and keeps it compressed in data. */
+static void
+kk_msl_store(struct msl_compile_data *data, char *text)
+{
+   const size_t length = strlen(text) + 1u;
+   const size_t max = util_compress_max_compressed_len(length);
+   uint8_t *packed = ralloc_size(NULL, max);
+   size_t size = packed ? util_compress_deflate((const uint8_t *)text, length,
+                                                packed, max)
+                        : 0u;
+   data->code_length = length;
+   if (size == 0u) {
+      /* Kept as plain text if it cannot be compressed. */
+      ralloc_free(packed);
+      data->code = (uint8_t *)text;
+      data->code_size = 0u;
+      return;
+   }
+   data->code = reralloc_size(NULL, packed, size);
+   if (data->code == NULL)
+      data->code = packed;
+   data->code_size = size;
+   ralloc_free(text);
+}
+
+/* The MSL text, as a new ralloc'd string for the caller to free. */
+static char *
+kk_msl_text(const struct msl_compile_data *data)
+{
+   if (data->code_size == 0u)
+      return ralloc_strdup(NULL, (const char *)data->code);
+   char *text = ralloc_size(NULL, data->code_length);
+   if (text != NULL &&
+       !util_compress_inflate(data->code, data->code_size, (uint8_t *)text,
+                              data->code_length)) {
+      ralloc_free(text);
+      return NULL;
+   }
+   return text;
+}
