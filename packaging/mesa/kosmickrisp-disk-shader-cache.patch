+/* Keeps built shaders on disk, so a game does not build again in every session the pipelines it
+ * built before. Its own pipeline cache would do that if it saved one, but ANGLE (Android's GL)
+ * does not save Vulkan pipeline caches on this driver, so every pipeline was built afresh each
+ * time a game started, and each new sight stuttered again. Keyed by the driver's build, so a
+ * changed driver starts a new cache. MESA_SHADER_CACHE_DIR chooses where it lives. */
+static void
+kk_physical_device_init_disk_cache(struct kk_physical_device *pdev)
+{
+#ifdef ENABLE_SHADER_CACHE
+   struct kk_instance *instance = kk_physical_device_instance(pdev);
+   char build[2 * sizeof(instance->driver_build_sha) + 1];
+   for (unsigned i = 0; i < sizeof(instance->driver_build_sha); i++)
+      snprintf(build + 2 * i, 3, "%02x", instance->driver_build_sha[i]);
+   pdev->vk.disk_cache = disk_cache_create("kosmickrisp", build, 0);
+#endif
+}
+
 static void
 kk_physical_device_free_disk_cache(struct kk_physical_device *pdev)
 {
