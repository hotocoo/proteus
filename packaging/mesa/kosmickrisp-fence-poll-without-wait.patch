    struct kk_sync_timeline *timeline =
       container_of(sync, struct kk_sync_timeline, base);
 
+   /* Polls (vkGetFenceStatus, zero timeouts) are answered from the event's value: a wait call
+    * enters the kernel even with no time to wait, and games poll fences thousands of times a
+    * second.
+    */
