+/* Emulated guests wait on every frame's GPU work, so another process's long GPU jobs (training,
+ * rendering) stall them. Metal has no public queue priority; MTL4 queues lack even the private
+ * -setGPUPriority:, so this makes the call IOGPU makes for legacy queues: priority 0 (high),
+ * background priority 2 (Metal's default). Measured under a busy GPU: 2-2.4x the frames of the
+ * default priority 1. Any missing piece leaves the queue at its default. */
+enum {
+   IOGPU_PRIORITY_HIGH = 0,      /* foreground levels: 0 high, 1 normal (Metal's default) */
+   IOGPU_BACKGROUND_DEFAULT = 2, /* Metal's own background priority, kept as is */
+};
+
+static void
+raise_gpu_priority(id queue)
+{
+   static int (*set_priority)(void *, const uint32_t *, uint32_t *);
+   static Ivar ivar;
+   static dispatch_once_t once;
+   dispatch_once(&once, ^{
+      Class cls = NSClassFromString(@"IOGPUMetal4CommandQueue");
+      ivar = cls ? class_getInstanceVariable(cls, "_commandQueue") : NULL;
+      set_priority = dlsym(RTLD_DEFAULT, "IOGPUCommandQueueSetPriorityAndBackground");
+   });
+   if (!ivar || !set_priority ||
+       ![queue isKindOfClass:NSClassFromString(@"IOGPUMetal4CommandQueue")])
+      return;
+   void *gpu_queue = *(void **)((char *)(__bridge void *)queue + ivar_getOffset(ivar));
+   if (!gpu_queue)
+      return;
+   const uint32_t args[3] = {IOGPU_PRIORITY_HIGH, IOGPU_BACKGROUND_DEFAULT, 0};
+   uint32_t out = 0;
+   set_priority(gpu_queue, args, &out);
+}
+
 /* MTL4CommandQueue */
 mtl_command_queue *
 mtl_new_command_queue(mtl_device *device)
 {
    @autoreleasepool {
       id<MTLDevice> dev = (id<MTLDevice>)device;
-      return [dev newMTL4CommandQueue];
+      id<MTL4CommandQueue> queue = [dev newMTL4CommandQueue];
+      raise_gpu_priority(queue);
+      return queue;
    }
 }
 
