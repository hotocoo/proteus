+/* Where a shader's Metal pipeline build stands (kk_shader::compile_state). */
+enum kk_compile_state {
+   /* Built while it was created, or nothing to build. */
+   KK_COMPILE_NOW = 0,
+   KK_COMPILE_QUEUED,
+   KK_COMPILE_RUNNING,
+   KK_COMPILE_DONE,
+   /* Destroyed while queued: the build thread frees it. */
+   KK_COMPILE_ABANDONED,
+};
