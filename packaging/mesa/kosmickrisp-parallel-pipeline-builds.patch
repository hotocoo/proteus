+/* Builds the shader's Metal pipeline. Failure leaves its handles NULL, and
+ * draws and dispatches with it are skipped. */
+static void
+kk_build_pipeline(struct kk_device *dev, struct kk_shader *shader)
+{
+   if (shader->vk.stage == MESA_SHADER_COMPUTE) {
+      uint32_t local_size_threads = shader->info.cs.local_size.x *
+                                    shader->info.cs.local_size.y *
+                                    shader->info.cs.local_size.z;
+      kk_compile_compute_pipeline(dev,
+                                  &shader->msl_data[MESA_SHADER_COMPUTE],
+                                  local_size_threads, &shader->pipeline.cs);
+   } else {
+      kk_compile_graphics_pipeline(dev, shader);
+   }
+}
+
+static void
+kk_build_pipeline_and_signal(struct kk_device *dev, struct kk_shader *shader)
+{
+   kk_build_pipeline(dev, shader);
+   mtx_lock(&dev->compile_lock);
+   /* Release: a reader that sees DONE without the lock sees the handles. */
+   __atomic_store_n(&shader->compile_state, KK_COMPILE_DONE, __ATOMIC_RELEASE);
+   cnd_broadcast(&dev->compile_done);
+   mtx_unlock(&dev->compile_lock);
+}
+
+static void
+kk_compile_job(void *job, UNUSED void *global_data, UNUSED int thread_index)
+{
+   struct kk_shader *shader = job;
+   struct kk_device *dev =
+      container_of(shader->vk.base.device, struct kk_device, vk);
+   bool build = false;
+
+   mtx_lock(&dev->compile_lock);
+   shader->compile_job_pending = false;
+   uint32_t state = shader->compile_state;
+   if (state == KK_COMPILE_QUEUED) {
+      if (p_atomic_read(&dev->compile_abandon)) {
+         shader->compile_state = KK_COMPILE_DONE;
+         cnd_broadcast(&dev->compile_done);
+      } else {
+         shader->compile_state = KK_COMPILE_RUNNING;
+         build = true;
+      }
+   }
+   mtx_unlock(&dev->compile_lock);
+
+   if (state == KK_COMPILE_ABANDONED)
+      kk_shader_free(dev, shader, NULL);
+   else if (build)
+      kk_build_pipeline_and_signal(dev, shader);
+}
+
+static void
+kk_queue_pipeline_build(struct kk_device *dev, struct kk_shader *shader)
+{
+   shader->compile_state = KK_COMPILE_QUEUED;
+   shader->compile_job_pending = true;
+   util_queue_add_job(&dev->compile_queue, shader, NULL, kk_compile_job, NULL,
+                      0);
+}
+
+void
+kk_shader_wait_compiled(struct kk_device *dev, struct kk_shader *shader)
+{
+   if (shader == NULL)
+      return;
+   uint32_t state = __atomic_load_n(&shader->compile_state, __ATOMIC_ACQUIRE);
+   if (state == KK_COMPILE_NOW || state == KK_COMPILE_DONE)
+      return;
+
+   mtx_lock(&dev->compile_lock);
+   if (shader->compile_state == KK_COMPILE_QUEUED) {
+      /* Needed now: build it here rather than wait behind the queue. */
+      shader->compile_state = KK_COMPILE_RUNNING;
+      mtx_unlock(&dev->compile_lock);
+      kk_build_pipeline_and_signal(dev, shader);
+      return;
+   }
+   while (shader->compile_state == KK_COMPILE_RUNNING)
+      cnd_wait(&dev->compile_done, &dev->compile_lock);
+   mtx_unlock(&dev->compile_lock);
+}
