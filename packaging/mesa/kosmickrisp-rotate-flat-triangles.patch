+#define kk_draw_offset(member) offsetof(struct kk_per_draw_data, member)
 
+static nir_def *
+kk_load_draw_u32(nir_builder *b, nir_def *per_draw, uint32_t offset)
+{
+   return nir_load_global_constant(b, 1, 32, nir_iadd_imm(b, per_draw, offset));
