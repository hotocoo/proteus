+       cmd->state.shaders[MESA_SHADER_GEOMETRY])
+      return false;
+   if (!requires_unroll_flatshade(cmd, data))
+      return false;
+   return !requires_unroll_robustness(cmd, data) &&
+          !requires_unroll_restart(cmd, data);
