+
+/* Replaces the vertex ID with a per-draw rotated one: for a draw flagged in kk_per_draw_data,
+ * vertex i of the non-indexed draw stands for corner (i % 3 + 2) % 3 of triangle i / 3, read
+ * from the index buffer when there is one. The last vertex of every triangle comes first, so
+ * Metal's first provoking vertex gives Vulkan's last, with no unroll pass and no render pass
+ * split. Draws without the flag see the vertex ID unchanged. */
 static bool
+kk_nir_rotate_vertex_id(nir_shader *nir)
+{
+   if (BITSET_TEST(nir->info.system_values_read, SYSTEM_VALUE_FIRST_VERTEX) ||
+       BITSET_TEST(nir->info.system_values_read, SYSTEM_VALUE_BASE_VERTEX) ||
+       BITSET_TEST(nir->info.system_values_read, SYSTEM_VALUE_IS_INDEXED_DRAW) ||
+       BITSET_TEST(nir->info.system_values_read, SYSTEM_VALUE_VERTEX_ID_ZERO_BASE))
+      return false;
+
+   nir_function_impl *impl = nir_shader_get_entrypoint(nir);
+   nir_builder b = nir_builder_at(nir_before_impl(impl));
+   nir_def *raw = nir_load_vertex_id(&b);
+   nir_def *per_draw = nir_load_per_draw_ptr_kk(&b, 1, 64);
+   nir_def *mode = kk_load_draw_u32(&b, per_draw, kk_draw_offset(rotate_mode));
+
+   nir_push_if(&b, nir_ine_imm(&b, mode, 0));
+   nir_def *corner = nir_umod_imm(&b, raw, 3);
+   nir_def *source = nir_iadd(&b, nir_isub(&b, raw, corner),
+                              nir_umod_imm(&b, nir_iadd_imm(&b, corner, 2), 3));
+   nir_def *pos = nir_iadd(&b, kk_load_draw_u32(&b, per_draw, kk_draw_offset(rotate_first)),
+                           source);
+   nir_def *size = kk_load_draw_u32(&b, per_draw, kk_draw_offset(rotate_index_size));
+   nir_push_if(&b, nir_ieq_imm(&b, size, 0));
+   nir_def *direct = pos;
+   nir_push_else(&b, NULL);
+   nir_def *base = nir_load_global_constant(
+      &b, 1, 64, nir_iadd_imm(&b, per_draw, kk_draw_offset(rotate_index_addr)));
+   nir_def *byte = nir_iadd(&b, base, nir_u2u64(&b, nir_imul(&b, pos, size)));
+   nir_def *word = nir_load_global_constant(&b, 1, 32, nir_iand_imm(&b, byte, ~3ull));
+   nir_def *shift = nir_imul_imm(&b, nir_u2u32(&b, nir_iand_imm(&b, byte, 3)), 8);
+   nir_def *mask = nir_bcsel(&b, nir_ieq_imm(&b, size, 1), nir_imm_int(&b, 0xff),
+                             nir_bcsel(&b, nir_ieq_imm(&b, size, 2), nir_imm_int(&b, 0xffff),
+                                       nir_imm_int(&b, ~0)));
+   nir_def *index = nir_iand(&b, nir_ushr(&b, word, shift), mask);
+   nir_def *indexed = nir_iadd(
+      &b, index, kk_load_draw_u32(&b, per_draw, kk_draw_offset(rotate_vertex_offset)));
+   nir_pop_if(&b, NULL);
+   nir_def *rotated = nir_if_phi(&b, direct, indexed);
+   nir_pop_if(&b, NULL);
+   nir_def *vid = nir_if_phi(&b, rotated, raw);
+
+   nir_foreach_block(block, impl) {
+      nir_foreach_instr_safe(instr, block) {
+         if (instr->type != nir_instr_type_intrinsic)
+            continue;
+         nir_intrinsic_instr *intr = nir_instr_as_intrinsic(instr);
+         if (intr->intrinsic != nir_intrinsic_load_vertex_id || &intr->def == raw)
+            continue;
+         nir_def_rewrite_uses(&intr->def, vid);
+         nir_instr_remove(instr);
+      }
+   }
+   BITSET_SET(nir->info.system_values_read, SYSTEM_VALUE_VERTEX_ID);
+   nir_progress(true, impl, nir_metadata_none);
+   return true;
+}
