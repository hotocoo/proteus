diff --git a/src/kosmickrisp/vulkan/kk_cmd_buffer.c b/src/kosmickrisp/vulkan/kk_cmd_buffer.c
index 22f4bf7f3..933c7b8e8 100644
--- a/src/kosmickrisp/vulkan/kk_cmd_buffer.c
+++ b/src/kosmickrisp/vulkan/kk_cmd_buffer.c
@@ -387,6 +387,12 @@ cs_end(struct kk_cmd_buffer *cmd)
 void
 kk_cmd_bind_root_to_argument_table(struct kk_cmd_buffer *cmd, uint64_t addr)
 {
+   /* Setting the same address again still marks the table changed, and Metal then binds every
+    * buffer again at the next draw: a third of the encoding time in a game. Every other writer of
+    * slot 0 puts root_addr back before returning.
+    */
+   if (addr == cmd->state.root_addr)
+      return;
    mtl_set_address(cmd->argument_table, addr, 0u);
    cmd->state.root_addr = addr;
 }
