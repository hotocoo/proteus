+/* Types flow both ways, to uses and back to the values used, and a pass
+ * in one direction moves them only one step the other way. Passes go
+ * forward and back in turn, so long chains settle in a few passes instead
+ * of one pass per step; the result is the same.
+ */
+static void
+propagate_all_types(nir_shader *shader, struct hash_table *types)
+{
+   bool progress;
+   do {
+      progress = false;
+      nir_foreach_function_impl(impl, shader) {
+         nir_foreach_block(block, impl) {
+            nir_foreach_instr(instr, block) {
+               progress |= propagate_types(types, instr);
+            }
+         }
+         nir_foreach_block_reverse(block, impl) {
+            nir_foreach_instr_reverse(instr, block) {
+               progress |= propagate_types(types, instr);
+            }
+         }
+      }
+   } while (progress);
+}
+
+static bool
+default_untyped_values(nir_shader *shader, struct hash_table *types)
+{
+   bool changed = false;
+   nir_foreach_function_impl(impl, shader) {
+      nir_foreach_block(block, impl) {
+         nir_foreach_instr(instr, block) {
+            if (instr->type == nir_instr_type_undef) {
+               nir_def *def = &nir_instr_as_undef(instr)->def;
+               if (get_type(types, def) == TYPE_NONE) {
+                  set_type(types, def, TYPE_GENERIC_DATA);
+                  changed = true;
+               }
+            } else if (instr->type == nir_instr_type_alu) {
+               nir_alu_instr *alu = nir_instr_as_alu(instr);
+               for (unsigned i = 0; i < nir_op_infos[alu->op].num_inputs; i++) {
+                  nir_src *src = &alu->src[i].src;
+                  if (get_type(types, src) == TYPE_NONE &&
+                      get_type(types, src->ssa) == TYPE_NONE) {
+                     set_type(types, src, TYPE_GENERIC_DATA);
+                     changed = true;
+                  }
+               }
+               if (get_type(types, &alu->def) == TYPE_NONE) {
+                  set_type(types, &alu->def, TYPE_GENERIC_DATA);
+                  changed = true;
+               }
+            }
+         }
+      }
    }
+   return changed;
 }
 
